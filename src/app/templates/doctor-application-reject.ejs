<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="x-apple-disable-message-reformatting" />

        <title>Doctor Verification Update - PH Healthcare System</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                background-color: #f1f5f9;
                font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            }

            table {
                border-spacing: 0;
                border-collapse: collapse;
            }

            @media only screen and (max-width: 640px) {
                .email-wrapper {
                    padding: 20px 10px !important;
                }

                .email-container {
                    width: 100% !important;
                    border-radius: 16px !important;
                }

                .header {
                    padding: 32px 20px !important;
                }

                .content {
                    padding: 30px 20px !important;
                }

                .header-title {
                    font-size: 24px !important;
                }

                .content-title {
                    font-size: 22px !important;
                }
            }

            @media only screen and (max-width: 400px) {
                .email-wrapper {
                    padding: 10px 5px !important;
                }

                .header {
                    padding: 28px 16px !important;
                }

                .content {
                    padding: 25px 16px !important;
                }

                .header-title {
                    font-size: 21px !important;
                }

                .content-title {
                    font-size: 20px !important;
                }
            }
        </style>
    </head>

    <body>
        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="width: 100%; background-color: #f1f5f9"
        >
            <tr>
                <td
                    class="email-wrapper"
                    align="center"
                    style="padding: 40px 15px"
                >
                    <table
                        role="presentation"
                        class="email-container"
                        width="620"
                        cellpadding="0"
                        cellspacing="0"
                        style="
                            width: 100%;
                            max-width: 620px;
                            background-color: #ffffff;
                            border: 1px solid #e2e8f0;
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                        "
                    >
                        <!-- Header -->
                        <tr>
                            <td
                                class="header"
                                align="center"
                                style="
                                    padding: 42px 30px 38px;
                                    background-color: #b91c1c;
                                    background-image: linear-gradient(
                                        135deg,
                                        #991b1b 0%,
                                        #dc2626 50%,
                                        #ea580c 100%
                                    );
                                    color: #ffffff;
                                "
                            >
                                <div
                                    style="
                                        width: 64px;
                                        height: 64px;
                                        line-height: 64px;
                                        margin: 0 auto 18px;
                                        background-color: rgba(
                                            255,
                                            255,
                                            255,
                                            0.18
                                        );
                                        border: 2px solid
                                            rgba(255, 255, 255, 0.4);
                                        border-radius: 50%;
                                        font-size: 30px;
                                        font-weight: bold;
                                    "
                                >
                                    !
                                </div>

                                <h1
                                    class="header-title"
                                    style="
                                        margin: 0;
                                        font-size: 28px;
                                        line-height: 1.3;
                                        color: #ffffff;
                                    "
                                >
                                    Verification Update
                                </h1>

                                <p
                                    style="
                                        margin: 10px 0 0;
                                        font-size: 15px;
                                        color: rgba(255, 255, 255, 0.9);
                                    "
                                >
                                    Your doctor verification requires attention
                                </p>
                            </td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td
                                class="content"
                                style="padding: 42px; color: #334155"
                            >
                                <h2
                                    class="content-title"
                                    style="
                                        margin: 0 0 18px;
                                        font-size: 24px;
                                        color: #0f172a;
                                    "
                                >
                                    Hello, <%= name %>
                                </h2>

                                <p
                                    style="
                                        font-size: 16px;
                                        line-height: 1.8;
                                        color: #475569;
                                    "
                                >
                                    Thank you for your interest in joining the
                                    PH Healthcare System. After reviewing your
                                    doctor verification request, we are unable
                                    to approve it at this time.
                                </p>

                                <!-- Reason Card -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    style="
                                        margin: 28px 0;
                                        background-color: #fef2f2;
                                        border: 1px solid #fecaca;
                                        border-radius: 16px;
                                    "
                                >
                                    <tr>
                                        <td style="padding: 24px">
                                            <h3
                                                style="
                                                    margin: 0 0 12px;
                                                    color: #b91c1c;
                                                    font-size: 18px;
                                                "
                                            >
                                                Reason for the Decision
                                            </h3>

                                            <p
                                                style="
                                                    margin: 0;
                                                    font-size: 15px;
                                                    line-height: 1.7;
                                                    color: #7f1d1d;
                                                    white-space: pre-line;
                                                "
                                            >
                                                <%= reason %>
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Information -->
                                <div
                                    style="
                                        background-color: #fff7ed;
                                        border-left: 4px solid #f97316;
                                        border-radius: 8px;
                                        padding: 18px;
                                    "
                                >
                                    <p
                                        style="
                                            margin: 0;
                                            font-size: 14px;
                                            line-height: 1.7;
                                            color: #9a3412;
                                        "
                                    >
                                        <strong>Please Note:</strong><br />
                                        This decision may be based on incomplete
                                        information or verification
                                        requirements. Please review the reason
                                        above carefully.
                                    </p>
                                </div>

                                <p
                                    style="
                                        margin-top: 30px;
                                        padding-top: 24px;
                                        border-top: 1px solid #e2e8f0;
                                        font-size: 15px;
                                        line-height: 1.7;
                                        color: #475569;
                                    "
                                >
                                    If you have questions regarding this
                                    decision, please contact the PH Healthcare
                                    System support team.
                                    <br /><br />

                                    Thank you for your understanding.
                                    <br /><br />

                                    Best regards,<br />
                                    <strong
                                        style="color: #0f172a; font-size: 16px"
                                    >
                                        PH Healthcare System Team
                                    </strong>
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                align="center"
                                style="
                                    padding: 26px 20px;
                                    background-color: #f8fafc;
                                    border-top: 1px solid #e2e8f0;
                                "
                            >
                                <p
                                    style="
                                        margin: 0;
                                        font-size: 13px;
                                        color: #64748b;
                                    "
                                >
                                    © <%= new Date().getFullYear() %> PH
                                    Healthcare System. All rights reserved.
                                </p>

                                <p
                                    style="
                                        margin: 8px 0 0;
                                        font-size: 12px;
                                        color: #94a3b8;
                                    "
                                >
                                    This is an automated notification. Please do
                                    not reply directly to this message.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
