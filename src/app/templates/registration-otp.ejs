<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="x-apple-disable-message-reformatting" />

        <title>Verify Your Account - PH Healthcare System</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                background-color: #f1f5f9;
                font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            table {
                border-spacing: 0;
                border-collapse: collapse;
            }

            img {
                border: 0;
                max-width: 100%;
                height: auto;
            }

            @media only screen and (max-width: 640px) {
                .email-wrapper {
                    padding: 20px 10px !important;
                }

                .email-container {
                    width: 100% !important;
                    max-width: 100% !important;
                    border-radius: 16px !important;
                }

                .header {
                    padding: 32px 20px 30px !important;
                }

                .header-title {
                    font-size: 24px !important;
                    line-height: 1.3 !important;
                }

                .header-subtitle {
                    font-size: 14px !important;
                }

                .header-icon {
                    width: 58px !important;
                    height: 58px !important;
                    line-height: 58px !important;
                    font-size: 26px !important;
                }

                .content {
                    padding: 30px 20px !important;
                }

                .content-title {
                    font-size: 22px !important;
                }

                .content-text {
                    font-size: 15px !important;
                    line-height: 1.7 !important;
                }

                .otp-box {
                    padding: 22px 12px !important;
                }

                .otp-code {
                    font-size: 28px !important;
                    letter-spacing: 6px !important;
                }

                .notice-box {
                    padding: 16px !important;
                }

                .footer {
                    padding: 22px 16px !important;
                }
            }

            @media only screen and (max-width: 400px) {
                .email-wrapper {
                    padding: 10px 5px !important;
                }

                .email-container {
                    border-radius: 12px !important;
                }

                .header {
                    padding: 28px 16px !important;
                }

                .header-title {
                    font-size: 21px !important;
                }

                .content {
                    padding: 25px 16px !important;
                }

                .content-title {
                    font-size: 20px !important;
                }

                .content-text {
                    font-size: 14px !important;
                }

                .otp-code {
                    font-size: 24px !important;
                    letter-spacing: 4px !important;
                }
            }
        </style>
    </head>

    <body>
        <!-- Full Background -->
        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 100%; background-color: #f1f5f9"
        >
            <tr>
                <td
                    class="email-wrapper"
                    align="center"
                    style="padding: 40px 15px"
                >
                    <!-- Main Container -->
                    <table
                        role="presentation"
                        class="email-container"
                        width="620"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="
                            width: 100%;
                            max-width: 620px;
                            background-color: #ffffff;
                            border: 1px solid #e2e8f0;
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                        "
                    >
                        <!-- Header -->
                        <tr>
                            <td
                                class="header"
                                align="center"
                                style="
                                    padding: 42px 30px 38px;
                                    background-color: #0f766e;
                                    background-image: linear-gradient(
                                        135deg,
                                        #0f766e 0%,
                                        #0891b2 50%,
                                        #2563eb 100%
                                    );
                                    color: #ffffff;
                                "
                            >
                                <!-- Healthcare Icon -->
                                <div
                                    class="header-icon"
                                    style="
                                        width: 64px;
                                        height: 64px;
                                        line-height: 64px;
                                        margin: 0 auto 18px;
                                        background-color: rgba(
                                            255,
                                            255,
                                            255,
                                            0.18
                                        );
                                        border: 2px solid
                                            rgba(255, 255, 255, 0.4);
                                        border-radius: 18px;
                                        font-size: 30px;
                                        font-weight: bold;
                                        color: #ffffff;
                                    "
                                >
                                    +
                                </div>

                                <h1
                                    class="header-title"
                                    style="
                                        margin: 0;
                                        font-size: 28px;
                                        line-height: 1.3;
                                        font-weight: 700;
                                        letter-spacing: -0.5px;
                                        color: #ffffff;
                                    "
                                >
                                    Verify Your Account
                                </h1>

                                <p
                                    class="header-subtitle"
                                    style="
                                        margin: 10px 0 0;
                                        font-size: 15px;
                                        line-height: 1.6;
                                        color: rgba(255, 255, 255, 0.9);
                                    "
                                >
                                    Complete your registration securely
                                </p>
                            </td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td
                                class="content"
                                style="padding: 42px 42px 35px; color: #334155"
                            >
                                <h2
                                    class="content-title"
                                    style="
                                        margin: 0 0 18px;
                                        color: #0f172a;
                                        font-size: 24px;
                                        line-height: 1.4;
                                        font-weight: 700;
                                    "
                                >
                                    Welcome, <%= name %>! 👋
                                </h2>

                                <p
                                    class="content-text"
                                    style="
                                        margin: 0 0 16px;
                                        font-size: 16px;
                                        line-height: 1.8;
                                        color: #475569;
                                    "
                                >
                                    Thank you for registering with
                                    <strong style="color: #0f172a">
                                        PH Healthcare System </strong
                                    >.
                                </p>

                                <p
                                    class="content-text"
                                    style="
                                        margin: 0;
                                        font-size: 16px;
                                        line-height: 1.8;
                                        color: #475569;
                                    "
                                >
                                    Please use the verification code below to
                                    confirm your account and complete your
                                    registration.
                                </p>

                                <!-- OTP Section -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin: 30px 0;
                                        background-color: #ecfeff;
                                        background-image: linear-gradient(
                                            135deg,
                                            #ecfeff 0%,
                                            #eff6ff 100%
                                        );
                                        border: 1px solid #bae6fd;
                                        border-radius: 16px;
                                    "
                                >
                                    <tr>
                                        <td
                                            class="otp-box"
                                            align="center"
                                            style="padding: 28px 20px"
                                        >
                                            <p
                                                style="
                                                    margin: 0 0 14px;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    letter-spacing: 1.5px;
                                                    color: #0284c7;
                                                    text-transform: uppercase;
                                                "
                                            >
                                                Your Verification Code
                                            </p>

                                            <div
                                                style="
                                                    display: inline-block;
                                                    padding: 16px 24px;
                                                    background-color: #ffffff;
                                                    border: 1px solid #cbd5e1;
                                                    border-radius: 12px;
                                                    box-shadow: 0 4px 12px
                                                        rgba(37, 99, 235, 0.1);
                                                "
                                            >
                                                <span
                                                    class="otp-code"
                                                    style="
                                                        font-size: 34px;
                                                        line-height: 1;
                                                        font-weight: 800;
                                                        letter-spacing: 10px;
                                                        color: #1d4ed8;
                                                        font-family:
                                                            &quot;Courier New&quot;,
                                                            monospace;
                                                    "
                                                >
                                                    <%= otp %>
                                                </span>
                                            </div>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Expiration Notice -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 20px;
                                        background-color: #fff7ed;
                                        border: 1px solid #fed7aa;
                                        border-radius: 12px;
                                    "
                                >
                                    <tr>
                                        <td
                                            class="notice-box"
                                            style="padding: 18px"
                                        >
                                            <p
                                                class="content-text"
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.7;
                                                    color: #9a3412;
                                                "
                                            >
                                                <strong>
                                                    ⏱ Verification expires soon
                                                </strong>
                                                <br />
                                                This OTP will expire in
                                                <strong>
                                                    <%= expirationMinutes %>
                                                    minutes </strong
                                                >.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Security Notice -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 26px;
                                        background-color: #f8fafc;
                                        border-left: 4px solid #0891b2;
                                        border-radius: 8px;
                                    "
                                >
                                    <tr>
                                        <td
                                            class="notice-box"
                                            style="padding: 18px"
                                        >
                                            <p
                                                class="content-text"
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.7;
                                                    color: #475569;
                                                "
                                            >
                                                <strong style="color: #0f172a">
                                                    🔒 Security Reminder
                                                </strong>
                                                <br />
                                                Never share this verification
                                                code with anyone. PH Healthcare
                                                System will never ask you for
                                                your OTP.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <p
                                    class="content-text"
                                    style="
                                        margin: 0;
                                        font-size: 15px;
                                        line-height: 1.8;
                                        color: #64748b;
                                    "
                                >
                                    If you did not create this account, you can
                                    safely ignore this email.
                                </p>

                                <!-- Signature -->
                                <div
                                    style="
                                        margin-top: 34px;
                                        padding-top: 24px;
                                        border-top: 1px solid #e2e8f0;
                                    "
                                >
                                    <p
                                        class="content-text"
                                        style="
                                            margin: 0;
                                            font-size: 15px;
                                            line-height: 1.7;
                                            color: #475569;
                                        "
                                    >
                                        Welcome to better healthcare,
                                        <br />
                                        <strong
                                            style="
                                                color: #0f172a;
                                                font-size: 16px;
                                            "
                                        >
                                            PH Healthcare System Team
                                        </strong>
                                    </p>
                                </div>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                class="footer"
                                align="center"
                                style="
                                    padding: 26px 30px;
                                    background-color: #f8fafc;
                                    background-image: linear-gradient(
                                        135deg,
                                        #f8fafc 0%,
                                        #eef2ff 100%
                                    );
                                    border-top: 1px solid #e2e8f0;
                                "
                            >
                                <p
                                    style="
                                        margin: 0;
                                        font-size: 13px;
                                        line-height: 1.6;
                                        color: #64748b;
                                    "
                                >
                                    © <%= new Date().getFullYear() %>
                                    <strong style="color: #334155">
                                        PH Healthcare System
                                    </strong>
                                    . All rights reserved.
                                </p>

                                <p
                                    style="
                                        margin: 8px 0 0;
                                        font-size: 12px;
                                        line-height: 1.6;
                                        color: #94a3b8;
                                    "
                                >
                                    This is an automated verification email.
                                    Please do not reply directly to this
                                    message.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
