<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Password Reset - PH Healthcare System</title>
    </head>

    <body
        style="
            margin: 0;
            padding: 0;
            background-color: #f1f5f9;
            font-family:
                &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        "
    >
        <!-- Email Wrapper -->
        <div style="width: 100%; padding: 40px 15px; box-sizing: border-box">
            <!-- Main Container -->
            <div
                style="
                    max-width: 620px;
                    margin: 0 auto;
                    background-color: #ffffff;
                    border-radius: 20px;
                    overflow: hidden;
                    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                    border: 1px solid #e2e8f0;
                "
            >
                <!-- Header -->
                <div
                    style="
                        background: linear-gradient(
                            135deg,
                            #0f766e 0%,
                            #0891b2 50%,
                            #2563eb 100%
                        );
                        padding: 42px 30px 38px;
                        text-align: center;
                        color: #ffffff;
                    "
                >
                    <!-- Logo / Icon -->
                    <div
                        style="
                            width: 58px;
                            height: 58px;
                            line-height: 58px;
                            margin: 0 auto 18px;
                            background-color: rgba(255, 255, 255, 0.18);
                            border: 1px solid rgba(255, 255, 255, 0.35);
                            border-radius: 16px;
                            font-size: 28px;
                            font-weight: bold;
                        "
                    >
                        +
                    </div>

                    <h1
                        style="
                            margin: 0;
                            font-size: 28px;
                            line-height: 1.3;
                            font-weight: 700;
                            letter-spacing: -0.5px;
                        "
                    >
                        PH Healthcare System
                    </h1>

                    <p
                        style="
                            margin: 10px 0 0;
                            font-size: 15px;
                            line-height: 1.6;
                            color: rgba(255, 255, 255, 0.85);
                        "
                    >
                        Secure Password Reset Verification
                    </p>
                </div>

                <!-- Content -->
                <div style="padding: 42px 42px 35px; color: #334155">
                    <h2
                        style="
                            margin: 0 0 18px;
                            color: #0f172a;
                            font-size: 24px;
                            line-height: 1.4;
                            font-weight: 700;
                        "
                    >
                        Hello, <%= name %> 👋
                    </h2>

                    <p
                        style="
                            margin: 0 0 16px;
                            font-size: 16px;
                            line-height: 1.8;
                            color: #475569;
                        "
                    >
                        We received a request to reset the password associated
                        with your
                        <strong style="color: #0f172a">
                            PH Healthcare System
                        </strong>
                        account.
                    </p>

                    <p
                        style="
                            margin: 0;
                            font-size: 16px;
                            line-height: 1.8;
                            color: #475569;
                        "
                    >
                        To continue, please enter the verification code below:
                    </p>

                    <!-- OTP Section -->
                    <div
                        style="
                            margin: 30px 0;
                            padding: 28px 20px;
                            text-align: center;
                            background: linear-gradient(
                                135deg,
                                #ecfeff 0%,
                                #eff6ff 100%
                            );
                            border: 1px solid #bae6fd;
                            border-radius: 16px;
                        "
                    >
                        <p
                            style="
                                margin: 0 0 14px;
                                font-size: 12px;
                                font-weight: 700;
                                letter-spacing: 1.5px;
                                color: #0284c7;
                                text-transform: uppercase;
                            "
                        >
                            Your Verification Code
                        </p>

                        <div
                            style="
                                display: inline-block;
                                padding: 14px 24px;
                                background-color: #ffffff;
                                border: 1px solid #cbd5e1;
                                border-radius: 12px;
                                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
                            "
                        >
                            <span
                                style="
                                    font-size: 34px;
                                    line-height: 1;
                                    font-weight: 800;
                                    letter-spacing: 10px;
                                    color: #1d4ed8;
                                    font-family:
                                        &quot;Courier New&quot;, monospace;
                                "
                            >
                                <%= otp %>
                            </span>
                        </div>
                    </div>

                    <!-- Expiration Notice -->
                    <div
                        style="
                            padding: 16px 18px;
                            margin-bottom: 28px;
                            background-color: #fff7ed;
                            border: 1px solid #fed7aa;
                            border-radius: 12px;
                        "
                    >
                        <p
                            style="
                                margin: 0;
                                font-size: 14px;
                                line-height: 1.6;
                                color: #9a3412;
                            "
                        >
                            <strong>⏱ Important:</strong>
                            This verification code will expire in
                            <strong><%= expirationMinutes %> minutes</strong>.
                        </p>
                    </div>

                    <!-- Security Notice -->
                    <div
                        style="
                            padding: 18px;
                            background-color: #f8fafc;
                            border-left: 4px solid #0891b2;
                            border-radius: 8px;
                        "
                    >
                        <p
                            style="
                                margin: 0;
                                font-size: 14px;
                                line-height: 1.7;
                                color: #475569;
                            "
                        >
                            <strong style="color: #0f172a">
                                Security Reminder
                            </strong>
                            <br />
                            Never share this code with anyone. PH Healthcare
                            System staff will never ask for your password or
                            verification code.
                        </p>
                    </div>

                    <p
                        style="
                            margin: 28px 0 0;
                            font-size: 15px;
                            line-height: 1.8;
                            color: #64748b;
                        "
                    >
                        Didn't request a password reset? You can safely ignore
                        this email. No changes will be made to your account.
                    </p>

                    <div
                        style="
                            margin-top: 34px;
                            padding-top: 24px;
                            border-top: 1px solid #e2e8f0;
                        "
                    >
                        <p
                            style="
                                margin: 0;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #475569;
                            "
                        >
                            Best regards,
                            <br />
                            <strong style="color: #0f172a; font-size: 16px">
                                PH Healthcare System Team
                            </strong>
                        </p>
                    </div>
                </div>

                <!-- Footer -->
                <div
                    style="
                        padding: 26px 30px;
                        text-align: center;
                        background: linear-gradient(
                            135deg,
                            #f8fafc 0%,
                            #eef2ff 100%
                        );
                        border-top: 1px solid #e2e8f0;
                    "
                >
                    <p
                        style="
                            margin: 0;
                            font-size: 13px;
                            line-height: 1.6;
                            color: #64748b;
                        "
                    >
                        © <%= new Date().getFullYear() %>
                        <strong style="color: #334155">
                            PH Healthcare System
                        </strong>
                        . All rights reserved.
                    </p>

                    <p
                        style="
                            margin: 8px 0 0;
                            font-size: 12px;
                            line-height: 1.6;
                            color: #94a3b8;
                        "
                    >
                        This is an automated security email. Please do not reply
                        directly to this message.
                    </p>
                </div>
            </div>
        </div>
    </body>
</html>
