<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="x-apple-disable-message-reformatting" />

        <title>Password Reset Successful - PH Healthcare System</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                background-color: #f1f5f9;
                font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            }

            table {
                border-spacing: 0;
                border-collapse: collapse;
            }

            td {
                padding: 0;
            }

            img {
                border: 0;
                max-width: 100%;
            }

            @media screen and (max-width: 640px) {
                .email-wrapper {
                    padding: 20px 10px !important;
                }

                .email-container {
                    width: 100% !important;
                    border-radius: 16px !important;
                }

                .header {
                    padding: 32px 20px 30px !important;
                }

                .header-title {
                    font-size: 24px !important;
                }

                .header-subtitle {
                    font-size: 14px !important;
                }

                .content {
                    padding: 30px 20px !important;
                }

                .content-title {
                    font-size: 22px !important;
                }

                .content-text {
                    font-size: 15px !important;
                    line-height: 1.7 !important;
                }

                .success-box {
                    padding: 22px 16px !important;
                }

                .footer {
                    padding: 22px 16px !important;
                }

                .icon-box {
                    width: 58px !important;
                    height: 58px !important;
                    line-height: 58px !important;
                    font-size: 28px !important;
                }
            }

            @media screen and (max-width: 400px) {
                .email-wrapper {
                    padding: 10px 5px !important;
                }

                .content {
                    padding: 25px 16px !important;
                }

                .header {
                    padding: 28px 16px !important;
                }

                .header-title {
                    font-size: 21px !important;
                }

                .content-title {
                    font-size: 20px !important;
                }
            }
        </style>
    </head>

    <body>
        <!-- Full Background -->
        <table
            role="presentation"
            width="100%"
            style="width: 100%; background-color: #f1f5f9"
        >
            <tr>
                <td
                    class="email-wrapper"
                    align="center"
                    style="padding: 40px 15px"
                >
                    <!-- Email Container -->
                    <table
                        role="presentation"
                        class="email-container"
                        width="620"
                        style="
                            width: 100%;
                            max-width: 620px;
                            background-color: #ffffff;
                            border: 1px solid #e2e8f0;
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                        "
                    >
                        <!-- HEADER -->
                        <tr>
                            <td
                                class="header"
                                align="center"
                                style="
                                    padding: 42px 30px 38px;
                                    background-color: #059669;
                                    background-image: linear-gradient(
                                        135deg,
                                        #059669 0%,
                                        #10b981 50%,
                                        #06b6d4 100%
                                    );
                                    color: #ffffff;
                                "
                            >
                                <!-- Success Icon -->
                                <div
                                    class="icon-box"
                                    style="
                                        width: 64px;
                                        height: 64px;
                                        line-height: 64px;
                                        margin: 0 auto 18px;
                                        border-radius: 50%;
                                        background-color: rgba(
                                            255,
                                            255,
                                            255,
                                            0.2
                                        );
                                        border: 2px solid
                                            rgba(255, 255, 255, 0.45);
                                        font-size: 32px;
                                        font-weight: bold;
                                        color: #ffffff;
                                    "
                                >
                                    ✓
                                </div>

                                <h1
                                    class="header-title"
                                    style="
                                        margin: 0;
                                        font-size: 28px;
                                        line-height: 1.35;
                                        font-weight: 700;
                                        color: #ffffff;
                                    "
                                >
                                    Password Reset Successful
                                </h1>

                                <p
                                    class="header-subtitle"
                                    style="
                                        margin: 10px 0 0;
                                        font-size: 15px;
                                        line-height: 1.6;
                                        color: rgba(255, 255, 255, 0.9);
                                    "
                                >
                                    Your account password has been updated
                                    securely
                                </p>
                            </td>
                        </tr>

                        <!-- CONTENT -->
                        <tr>
                            <td
                                class="content"
                                style="padding: 42px; color: #334155"
                            >
                                <h2
                                    class="content-title"
                                    style="
                                        margin: 0 0 18px;
                                        font-size: 25px;
                                        line-height: 1.4;
                                        font-weight: 700;
                                        color: #0f172a;
                                    "
                                >
                                    Hello, <%= name %>! 👋
                                </h2>

                                <p
                                    class="content-text"
                                    style="
                                        margin: 0 0 16px;
                                        font-size: 16px;
                                        line-height: 1.8;
                                        color: #475569;
                                    "
                                >
                                    Great news! Your password for
                                    <strong style="color: #0f172a">
                                        PH Healthcare System
                                    </strong>
                                    has been successfully reset.
                                </p>

                                <!-- SUCCESS CARD -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    style="
                                        width: 100%;
                                        margin: 28px 0;
                                        background-color: #ecfdf5;
                                        background-image: linear-gradient(
                                            135deg,
                                            #ecfdf5 0%,
                                            #f0fdfa 100%
                                        );
                                        border: 1px solid #a7f3d0;
                                        border-radius: 16px;
                                    "
                                >
                                    <tr>
                                        <td
                                            class="success-box"
                                            align="center"
                                            style="padding: 26px 20px"
                                        >
                                            <div
                                                style="
                                                    width: 52px;
                                                    height: 52px;
                                                    line-height: 52px;
                                                    margin: 0 auto 14px;
                                                    background-color: #059669;
                                                    border-radius: 50%;
                                                    color: #ffffff;
                                                    font-size: 28px;
                                                    font-weight: bold;
                                                "
                                            >
                                                ✓
                                            </div>

                                            <h3
                                                style="
                                                    margin: 0 0 8px;
                                                    font-size: 19px;
                                                    line-height: 1.4;
                                                    color: #047857;
                                                "
                                            >
                                                Password Updated Successfully
                                            </h3>

                                            <p
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.7;
                                                    color: #065f46;
                                                "
                                            >
                                                Your new password is now active.
                                                You can securely sign in to your
                                                account.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- SECURITY NOTICE -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    style="
                                        width: 100%;
                                        margin-bottom: 18px;
                                        background-color: #f8fafc;
                                        border-left: 4px solid #0891b2;
                                        border-radius: 8px;
                                    "
                                >
                                    <tr>
                                        <td style="padding: 18px">
                                            <p
                                                class="content-text"
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.7;
                                                    color: #475569;
                                                "
                                            >
                                                <strong
                                                    style="
                                                        color: #0f172a;
                                                        font-size: 15px;
                                                    "
                                                >
                                                    🔒 Security Notice
                                                </strong>

                                                <br />

                                                If you made this change, no
                                                further action is required. Your
                                                new password is active and ready
                                                to use.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- WARNING -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    style="
                                        width: 100%;
                                        margin-bottom: 26px;
                                        background-color: #fff7ed;
                                        border: 1px solid #fed7aa;
                                        border-radius: 12px;
                                    "
                                >
                                    <tr>
                                        <td style="padding: 18px">
                                            <p
                                                class="content-text"
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.7;
                                                    color: #9a3412;
                                                "
                                            >
                                                <strong style="font-size: 15px">
                                                    ⚠️ Didn't reset your
                                                    password?
                                                </strong>

                                                <br />

                                                If you did not request this
                                                password reset, please contact
                                                our support team immediately to
                                                help secure your account.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <p
                                    class="content-text"
                                    style="
                                        margin: 0;
                                        font-size: 15px;
                                        line-height: 1.8;
                                        color: #64748b;
                                    "
                                >
                                    For your security, we recommend using a
                                    strong and unique password that you do not
                                    use on other websites.
                                </p>

                                <!-- SIGNATURE -->
                                <div
                                    style="
                                        margin-top: 30px;
                                        padding-top: 24px;
                                        border-top: 1px solid #e2e8f0;
                                    "
                                >
                                    <p
                                        class="content-text"
                                        style="
                                            margin: 0;
                                            font-size: 15px;
                                            line-height: 1.7;
                                            color: #475569;
                                        "
                                    >
                                        Best regards,
                                        <br />
                                        <strong
                                            style="
                                                color: #0f172a;
                                                font-size: 16px;
                                            "
                                        >
                                            PH Healthcare System Team
                                        </strong>
                                    </p>
                                </div>
                            </td>
                        </tr>

                        <!-- FOOTER -->
                        <tr>
                            <td
                                class="footer"
                                align="center"
                                style="
                                    padding: 26px 30px;
                                    background-color: #f8fafc;
                                    background-image: linear-gradient(
                                        135deg,
                                        #f8fafc 0%,
                                        #ecfdf5 100%
                                    );
                                    border-top: 1px solid #e2e8f0;
                                "
                            >
                                <p
                                    style="
                                        margin: 0;
                                        font-size: 13px;
                                        line-height: 1.6;
                                        color: #64748b;
                                    "
                                >
                                    © <%= new Date().getFullYear() %>
                                    <strong style="color: #334155">
                                        PH Healthcare System
                                    </strong>
                                    . All rights reserved.
                                </p>

                                <p
                                    style="
                                        margin: 8px 0 0;
                                        font-size: 12px;
                                        line-height: 1.6;
                                        color: #94a3b8;
                                    "
                                >
                                    This is an automated security notification.
                                    Please do not reply directly to this email.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
