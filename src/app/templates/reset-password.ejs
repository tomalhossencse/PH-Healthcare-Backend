<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Password Reset Successful - PH Healthcare System</title>
    </head>

    <body
        style="
            margin: 0;
            padding: 0;
            background-color: #f1f5f9;
            font-family:
                &quot;Segoe UI&quot;, Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        "
    >
        <!-- Email Wrapper -->
        <div style="width: 100%; padding: 40px 15px; box-sizing: border-box">
            <!-- Main Container -->
            <div
                style="
                    max-width: 620px;
                    margin: 0 auto;
                    background-color: #ffffff;
                    border-radius: 20px;
                    overflow: hidden;
                    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                    border: 1px solid #e2e8f0;
                "
            >
                <!-- Header -->
                <div
                    style="
                        background: linear-gradient(
                            135deg,
                            #059669 0%,
                            #10b981 50%,
                            #06b6d4 100%
                        );
                        padding: 42px 30px 38px;
                        text-align: center;
                        color: #ffffff;
                    "
                >
                    <!-- Success Icon -->
                    <div
                        style="
                            width: 64px;
                            height: 64px;
                            line-height: 64px;
                            margin: 0 auto 18px;
                            background-color: rgba(255, 255, 255, 0.2);
                            border: 2px solid rgba(255, 255, 255, 0.4);
                            border-radius: 50%;
                            font-size: 32px;
                            font-weight: bold;
                            color: #ffffff;
                        "
                    >
                        ✓
                    </div>

                    <h1
                        style="
                            margin: 0;
                            font-size: 28px;
                            line-height: 1.3;
                            font-weight: 700;
                            letter-spacing: -0.5px;
                        "
                    >
                        Password Reset Successful
                    </h1>

                    <p
                        style="
                            margin: 10px 0 0;
                            font-size: 15px;
                            line-height: 1.6;
                            color: rgba(255, 255, 255, 0.9);
                        "
                    >
                        Your PH Healthcare System account is now secure
                    </p>
                </div>

                <!-- Content -->
                <div style="padding: 42px 42px 35px; color: #334155">
                    <h2
                        style="
                            margin: 0 0 18px;
                            color: #0f172a;
                            font-size: 24px;
                            line-height: 1.4;
                            font-weight: 700;
                        "
                    >
                        Hello, <%= name %>!
                    </h2>

                    <p
                        style="
                            margin: 0 0 16px;
                            font-size: 16px;
                            line-height: 1.8;
                            color: #475569;
                        "
                    >
                        Great news! Your password for your
                        <strong style="color: #0f172a">
                            PH Healthcare System
                        </strong>
                        account has been successfully reset.
                    </p>

                    <!-- Success Message -->
                    <div
                        style="
                            margin: 28px 0;
                            padding: 22px;
                            text-align: center;
                            background: linear-gradient(
                                135deg,
                                #ecfdf5 0%,
                                #f0fdfa 100%
                            );
                            border: 1px solid #a7f3d0;
                            border-radius: 16px;
                        "
                    >
                        <div
                            style="
                                font-size: 32px;
                                line-height: 1;
                                margin-bottom: 12px;
                            "
                        >
                            ✓
                        </div>

                        <h3
                            style="
                                margin: 0 0 8px;
                                font-size: 18px;
                                color: #047857;
                            "
                        >
                            Password Updated Successfully
                        </h3>

                        <p
                            style="
                                margin: 0;
                                font-size: 14px;
                                line-height: 1.6;
                                color: #065f46;
                            "
                        >
                            You can now use your new password to securely access
                            your account.
                        </p>
                    </div>

                    <!-- Security Notice -->
                    <div
                        style="
                            padding: 18px;
                            margin-bottom: 24px;
                            background-color: #f8fafc;
                            border-left: 4px solid #0891b2;
                            border-radius: 8px;
                        "
                    >
                        <p
                            style="
                                margin: 0;
                                font-size: 14px;
                                line-height: 1.7;
                                color: #475569;
                            "
                        >
                            <strong style="color: #0f172a">
                                🔒 Security Notice
                            </strong>
                            <br />
                            If you made this change, no further action is
                            required. Your new password is now active.
                        </p>
                    </div>

                    <!-- Unauthorized Change Warning -->
                    <div
                        style="
                            padding: 18px;
                            margin-bottom: 28px;
                            background-color: #fff7ed;
                            border: 1px solid #fed7aa;
                            border-radius: 12px;
                        "
                    >
                        <p
                            style="
                                margin: 0;
                                font-size: 14px;
                                line-height: 1.7;
                                color: #9a3412;
                            "
                        >
                            <strong>⚠️ Didn't reset your password?</strong>
                            <br />
                            If you did not request this password change, please
                            contact our support team immediately to help secure
                            your account.
                        </p>
                    </div>

                    <p
                        style="
                            margin: 0;
                            font-size: 15px;
                            line-height: 1.8;
                            color: #64748b;
                        "
                    >
                        For your security, we recommend keeping your password
                        private and using a strong, unique password that you do
                        not use on other websites.
                    </p>

                    <!-- Signature -->
                    <div
                        style="
                            margin-top: 34px;
                            padding-top: 24px;
                            border-top: 1px solid #e2e8f0;
                        "
                    >
                        <p
                            style="
                                margin: 0;
                                font-size: 15px;
                                line-height: 1.7;
                                color: #475569;
                            "
                        >
                            Best regards,
                            <br />
                            <strong style="color: #0f172a; font-size: 16px">
                                PH Healthcare System Team
                            </strong>
                        </p>
                    </div>
                </div>

                <!-- Footer -->
                <div
                    style="
                        padding: 26px 30px;
                        text-align: center;
                        background: linear-gradient(
                            135deg,
                            #f8fafc 0%,
                            #ecfdf5 100%
                        );
                        border-top: 1px solid #e2e8f0;
                    "
                >
                    <p
                        style="
                            margin: 0;
                            font-size: 13px;
                            line-height: 1.6;
                            color: #64748b;
                        "
                    >
                        © <%= new Date().getFullYear() %>
                        <strong style="color: #334155">
                            PH Healthcare System
                        </strong>
                        . All rights reserved.
                    </p>

                    <p
                        style="
                            margin: 8px 0 0;
                            font-size: 12px;
                            line-height: 1.6;
                            color: #94a3b8;
                        "
                    >
                        This is an automated security notification. Please do
                        not reply directly to this email.
                    </p>
                </div>
            </div>
        </div>
    </body>
</html>
