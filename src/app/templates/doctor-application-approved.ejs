<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="x-apple-disable-message-reformatting" />

        <title>Doctor Verification Approved - PH Healthcare System</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                background-color: #f1f5f9;
                font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            table {
                border-spacing: 0;
                border-collapse: collapse;
            }

            @media only screen and (max-width: 640px) {
                .email-wrapper {
                    padding: 20px 10px !important;
                }

                .email-container {
                    width: 100% !important;
                    border-radius: 16px !important;
                }

                .header {
                    padding: 32px 20px !important;
                }

                .content {
                    padding: 30px 20px !important;
                }

                .header-title {
                    font-size: 24px !important;
                }

                .content-title {
                    font-size: 22px !important;
                }
            }

            @media only screen and (max-width: 400px) {
                .email-wrapper {
                    padding: 10px 5px !important;
                }

                .header {
                    padding: 28px 16px !important;
                }

                .content {
                    padding: 25px 16px !important;
                }

                .header-title {
                    font-size: 21px !important;
                }

                .content-title {
                    font-size: 20px !important;
                }
            }
        </style>
    </head>

    <body>
        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="width: 100%; background-color: #f1f5f9"
        >
            <tr>
                <td
                    class="email-wrapper"
                    align="center"
                    style="padding: 40px 15px"
                >
                    <table
                        role="presentation"
                        class="email-container"
                        width="620"
                        cellpadding="0"
                        cellspacing="0"
                        style="
                            width: 100%;
                            max-width: 620px;
                            background-color: #ffffff;
                            border: 1px solid #e2e8f0;
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                        "
                    >
                        <!-- Header -->
                        <tr>
                            <td
                                class="header"
                                align="center"
                                style="
                                    padding: 42px 30px 38px;
                                    background-color: #059669;
                                    background-image: linear-gradient(
                                        135deg,
                                        #047857 0%,
                                        #059669 50%,
                                        #0d9488 100%
                                    );
                                    color: #ffffff;
                                "
                            >
                                <div
                                    style="
                                        width: 64px;
                                        height: 64px;
                                        line-height: 64px;
                                        margin: 0 auto 18px;
                                        background-color: rgba(
                                            255,
                                            255,
                                            255,
                                            0.18
                                        );
                                        border: 2px solid
                                            rgba(255, 255, 255, 0.4);
                                        border-radius: 50%;
                                        font-size: 32px;
                                        font-weight: bold;
                                    "
                                >
                                    ✓
                                </div>

                                <h1
                                    class="header-title"
                                    style="
                                        margin: 0;
                                        font-size: 28px;
                                        line-height: 1.3;
                                        color: #ffffff;
                                    "
                                >
                                    Verification Approved!
                                </h1>

                                <p
                                    style="
                                        margin: 10px 0 0;
                                        font-size: 15px;
                                        color: rgba(255, 255, 255, 0.9);
                                    "
                                >
                                    Welcome to the PH Healthcare System medical
                                    team
                                </p>
                            </td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td
                                class="content"
                                style="padding: 42px; color: #334155"
                            >
                                <h2
                                    class="content-title"
                                    style="
                                        margin: 0 0 18px;
                                        font-size: 24px;
                                        color: #0f172a;
                                    "
                                >
                                    Congratulations, <%= name %>! 🎉
                                </h2>

                                <p
                                    style="
                                        font-size: 16px;
                                        line-height: 1.8;
                                        color: #475569;
                                    "
                                >
                                    We are pleased to inform you that your
                                    doctor profile and verification request have
                                    been successfully reviewed and approved.
                                </p>

                                <!-- Success Card -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    style="
                                        margin: 28px 0;
                                        background-color: #ecfdf5;
                                        border: 1px solid #a7f3d0;
                                        border-radius: 16px;
                                    "
                                >
                                    <tr>
                                        <td
                                            align="center"
                                            style="padding: 26px 20px"
                                        >
                                            <h3
                                                style="
                                                    margin: 0 0 8px;
                                                    font-size: 19px;
                                                    color: #047857;
                                                "
                                            >
                                                Your Doctor Account Is Approved
                                                ✓
                                            </h3>

                                            <p
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.7;
                                                    color: #065f46;
                                                "
                                            >
                                                You can now access your doctor
                                                account and start using the
                                                healthcare platform.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <h3
                                    style="
                                        font-size: 17px;
                                        color: #0f172a;
                                        margin-bottom: 14px;
                                    "
                                >
                                    You can now:
                                </h3>

                                <div
                                    style="
                                        background-color: #f8fafc;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 14px;
                                        padding: 20px;
                                        font-size: 14px;
                                        line-height: 2;
                                        color: #475569;
                                    "
                                >
                                    ✓ Manage your professional profile<br />
                                    ✓ View and manage patient appointments<br />
                                    ✓ Access your doctor dashboard<br />
                                    ✓ Provide healthcare services securely
                                </div>

                                <p
                                    style="
                                        margin-top: 30px;
                                        padding-top: 24px;
                                        border-top: 1px solid #e2e8f0;
                                        font-size: 15px;
                                        line-height: 1.7;
                                        color: #475569;
                                    "
                                >
                                    Thank you for joining our healthcare
                                    community. We are excited to have you as a
                                    part of PH Healthcare System.
                                    <br /><br />

                                    Best regards,<br />
                                    <strong
                                        style="color: #0f172a; font-size: 16px"
                                    >
                                        PH Healthcare System Team
                                    </strong>
                                </p>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                align="center"
                                style="
                                    padding: 26px 20px;
                                    background-color: #f8fafc;
                                    border-top: 1px solid #e2e8f0;
                                "
                            >
                                <p
                                    style="
                                        margin: 0;
                                        font-size: 13px;
                                        color: #64748b;
                                    "
                                >
                                    © <%= new Date().getFullYear() %> PH
                                    Healthcare System. All rights reserved.
                                </p>

                                <p
                                    style="
                                        margin: 8px 0 0;
                                        font-size: 12px;
                                        color: #94a3b8;
                                    "
                                >
                                    This is an automated email. Please do not
                                    reply directly to this message.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
